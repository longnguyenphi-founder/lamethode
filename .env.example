# Sao chép file này thành .env.local rồi điền giá trị (xem google-apps-script/README.md).
# KHÔNG đưa .env.local lên Git.

# Web app URL của Google Apps Script (dạng https://script.google.com/macros/s/XXXX/exec)
GOOGLE_SHEETS_WEBHOOK_URL=

# Chuỗi bí mật, phải giống Script property SECRET trong Apps Script
GOOGLE_SHEETS_SECRET=
